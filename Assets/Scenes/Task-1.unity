  dialogueList:
  - label: 0
    audioClip: {fileID: 8300000, guid: b52ee4b706c7be043a6a817bd6768dfd, type: 3}
    textContent: "Task-1. Setting up V-lock Plate.\r\nHere you will be putting a
      Big screw in the screw hole of the V-Lock plate. \r\nPlease verify if you have
      the necessary parts (V-lock plate and Big Screw) with you. \r\nonce you have
      verified the parts, please press done on the main screen. "
    specificDisplay: {fileID: 40671283}
  - label: 1
    audioClip: {fileID: 8300000, guid: 5f15db30b99e7af4b97a93527956c314, type: 3}
    textContent: Now, screw the Big screw in the threaded hole of the V-lock as shown
      in the assembly tab. Once you are done, please press the done button and proceed
      with the next task.
    specificDisplay: {fileID: 40671283}
  playOnStart: 1
  startIndex: 0
