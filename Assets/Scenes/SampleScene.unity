  m_Name: 
  m_EditorClassIdentifier: 
  dialogueList:
  - label: 0
    audioClip: {fileID: 8300000, guid: a44a5adf7ba03924cb55b8f451d3f683, type: 3}
    textContent: 'Welcome to V-lock assembly. Here you will be learning how to assemble
      a simple v-lock in a step by step tutorial. Please press the start button to
      go to the main menu. '
    specificDisplay: {fileID: 0}
  - label: 1
    audioClip: {fileID: 8300000, guid: a6799d6ae955443478586e2a3ace3c57, type: 3}
    textContent: 'This is a V-lock assembly. It consists of eight components: Tools,
      Housing, Big Screw, Small Screw, V-lock Plate, Plunger, Helical Spring, and
      Cover. Your task is to assemble these parts by following a step-by-step procedure.
      Please note that steps must be completed in sequence. You can access the handy
      menu at any time by opening your palm. To begin, please click the back button
      and proceed with the tasks. '
    specificDisplay: {fileID: 1389406502}
  playOnStart: 1
  startIndex: 0
  audioSource: {fileID: 299427044}
  globalDisplayTMP: {fileID: 1058484860}
  wordSpeed: 0.3
